# Vite content-hashes everything under /assets (filename changes when the
# content does), so it's safe to cache those forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images/videos/logos/fonts are NOT hashed (served straight from public/ by
# filename), so a week-long cache balances real repeat-visit speed against
# not serving stale media for a year after a file gets swapped.
/images/*
  Cache-Control: public, max-age=604800

/videos/*
  Cache-Control: public, max-age=604800

/logos/*
  Cache-Control: public, max-age=604800

/favicon.png
  Cache-Control: public, max-age=604800
